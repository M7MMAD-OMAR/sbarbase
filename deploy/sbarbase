#!/bin/sh
# The sbarbase operator command, run from the installation directory this file sits in.
# Link it onto PATH if you like: sudo ln -s /opt/sbarbase/deploy/sbarbase /usr/local/bin/sbarbase
# Run it as the service account, which owns the state: sudo -u sbarbase sbarbase status
set -eu
here=$(dirname "$(readlink -f "$0")")
root=$(dirname "$here")
bun=${SBARBASE_BUN:-}
if [ -z "$bun" ]; then
  bun=$(command -v bun 2>/dev/null || true)
fi
if [ -z "$bun" ] && [ -x "${HOME:-/nonexistent}/.bun/bin/bun" ]; then
  bun=$HOME/.bun/bin/bun
fi
if [ -z "$bun" ]; then
  echo 'sbarbase: bun is not on PATH; set SBARBASE_BUN to the bun binary' >&2
  exit 1
fi
cd "$root"
exec "$bun" "$root/lab/sbarbase.ts" "$@"
