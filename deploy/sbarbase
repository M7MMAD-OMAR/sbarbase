#!/bin/sh
# The sbarbase operator command, run from the installation directory this file sits in.
# Link it onto PATH if you like: sudo ln -s /opt/sbarbase/deploy/sbarbase /usr/local/bin/sbarbase
# Run it as the service account, which owns the state: sudo -u sbarbase sbarbase status
set -eu
here=$(dirname "$(readlink -f "$0")")
root=$(dirname "$here")
# sudo resets PATH and may keep the caller's HOME, so bun is looked for in order: SBARBASE_BUN,
# PATH, the running account's own home, then the PATH the installed unit gives the service.
bun=${SBARBASE_BUN:-}
if [ -z "$bun" ]; then
  bun=$(command -v bun 2>/dev/null || true)
fi
if [ -z "$bun" ]; then
  for home in "${HOME:-}" "$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6)"; do
    if [ -n "$home" ] && [ -x "$home/.bun/bin/bun" ]; then
      bun=$home/.bun/bin/bun
      break
    fi
  done
fi
if [ -z "$bun" ] && [ -r /etc/systemd/system/sbarbase.service ]; then
  unit_path=$(sed -n 's/^Environment=PATH=//p' /etc/systemd/system/sbarbase.service | head -n 1)
  bun=$(PATH=$unit_path command -v bun 2>/dev/null || true)
fi
if [ -z "$bun" ]; then
  echo 'sbarbase: bun was not found; set SBARBASE_BUN to the bun binary' >&2
  exit 1
fi
cd "$root"
exec "$bun" "$root/lab/sbarbase.ts" "$@"
