# Reference metadata needs registry access and public Git, without a daemon socket.
# Supply the locally built source image; this sentinel is not published.
ARG SOURCE_VERIFY_IMAGE=sbarbase-source-verify:required-source-image
FROM docker:29-cli@sha256:b1805116a6a86cc591b5d5f60a910a0715cdcc9d18d866ad68b1457ead25c35c AS cli
FROM ${SOURCE_VERIFY_IMAGE}
USER root
COPY --from=cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=cli /usr/local/libexec/docker/cli-plugins/ /usr/local/libexec/docker/cli-plugins/
USER sbarbase
RUN docker --version && docker compose version && docker buildx version
ENTRYPOINT ["/usr/bin/python3", "deploy/verify/reference_bundle.py"]
