   "/api/platform/auth/[ref]/invite",
   "/magiclink",
   "/otp",
   "/recover",
   "/users",
   "/users/[id]",
   "/users/[id]/factors"
  ],
  "server_route_missing": "/api/platform/auth/[ref]/config (curl returned 404)",
  "experiment": "One container of the pinned digest, no database, loopback port; built-in browser opened /project/default/auth/providers. The page rendered skeleton rows under User Signups; the left menu listed only Users and Policies; performance entries and network list held no request to auth/config.",
  "verdict": "Option (a) needs a client patch of minified chunks on every pin update, which is a fork. Chosen: option (b), a console native Authentication workspace."
 },
