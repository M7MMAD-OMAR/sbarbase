{
  "schema_version": 1,
  "mode": "feature",
  "approval": "delegated",
  "environment": "local-isolated",
  "requirements": [
    {
      "id": "R1",
      "text": "Source contract: refuse unsupported architecture/cgroups/filesystem/data-root/security/endpoint before host Compose mutations; existing Docker profile canonical admission reused."
    },
    {
      "id": "R2",
      "text": "Wire relevant startup/install/resource entrypoints before files, locks, dependencies, resources. Primary host path needs only POSIX shell and public Linux utilities plus Docker/Compose."
    },
    {
      "id": "R3",
      "text": "Replay shell fixtures for malformed/unavailable and unsupported inputs with mutation tripwires and before/after owned trees; run changed callers; fresh independent review."
    },
    {
      "id": "R4",
      "text": "Truthful initial Linux x86_64 local rootful candidate only, supported-profile acceptance and production unproven; actual clean host/install/reboot/full recovery pending coordinated runtime role."
    }
  ],
  "checkpoints": [
    {
      "id": "source",
      "title": "Host admission implementation and isolated source verification",
      "covers": [
        "R1",
        "R2",
        "R3",
        "R4"
      ],
